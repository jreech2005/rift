# Rift environment template. Copy to .env (git-ignored) and fill in.
# Never commit real keys, passwords or database URLs. Keys stay server-side.

# --- Gemini: primary Director LLM (docs/DIRECTOR.md, "Failover") -------------
GEMINI_API_KEY=
# Unset: the backend defaults. Demo: a fast primary and a second model on the same key.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Demo values. Code defaults are longer (8000 ms, 1 retry).
GEMINI_TIMEOUT_MS=3000
GEMINI_TRANSIENT_RETRIES=1

# --- Director failover -------------------------------------------------------
# DIRECTOR_PRIMARY_PROVIDER=gemini
# Optional independent provider; left out of the chain when its key is missing.
DIRECTOR_SECONDARY_PROVIDER=anthropic
# Total time the LLM chain gets per decision, retries and repair included.
# After it the deterministic FallbackDirector answers at once.
# Demo value. Code default is 20000 (1000-60000).
DIRECTOR_BUDGET_MS=6000

# --- Anthropic: optional secondary Director LLM ------------------------------
# Not required. Without a key the chain is Gemini -> deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Demo value. Code default is 10000.
ANTHROPIC_TIMEOUT_MS=3000
# ANTHROPIC_EFFORT=low

# --- Tiger Data: recent behavioral telemetry (docs/TELEMETRY.md) -------------
# Backend only, with `--features tiger`. Unset: telemetry stays in memory.
# postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_DATABASE_URL=

# --- TiDB: persistent semantic NPC/world memory (docs/NPC_MEMORY.md) ----------------
TIDB_HOST=
TIDB_PORT=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=

# --- ElevenLabs: NPC voice (docs/VOICE.md) -----------------------------------
# Needs the key and at least one voice. Unset: dialogue is text only.
ELEVENLABS_API_KEY=
# npc_id=voice_id pairs, e.g. hank_schrader=<voice_id>,walter_white=<voice_id>
ELEVENLABS_VOICES=
# Unset: eleven_flash_v2_5
ELEVENLABS_MODEL=
# Unreal plays 16-bit PCM WAV only: keep pcm_24000 for the demo.
# (Code default is mp3_44100_128, which Unreal shows as subtitles without sound.)
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
# Per line; after it the line goes out as text. Code default is 6000.
ELEVENLABS_TIMEOUT_MS=3000

# --- Canon pipeline ----------------------------------------------------------
TMDB_API_KEY=
WORLD_LABS_API_KEY=

# --- Runtime (docs/RUNTIME.md). Unset: sessions run without a world. ---------
# RIFT_WORLD_BIBLE=cache/universes/<universe_id>.json
# RIFT_SCENARIO=backend/tests/fixtures/runtime/scenario_burner_phone.json

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000

RUST_LOG=info
