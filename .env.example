GEMINI_API_KEY=
TMDB_API_KEY=
WORLD_LABS_API_KEY=
ELEVENLABS_API_KEY=

TIDB_HOST=
TIDB_PORT=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=

# Tiger Data gameplay telemetry (docs/TELEMETRY.md). Backend only, with
# `--features tiger`. Unset: telemetry stays in memory.
# postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Phase 2 runtime (docs/RUNTIME.md). Unset: sessions run without a world.
# RIFT_WORLD_BIBLE=cache/universes/<universe_id>.json
# RIFT_SCENARIO=backend/tests/fixtures/runtime/scenario_burner_phone.json

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000

RUST_LOG=info
