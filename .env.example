GEMINI_API_KEY=
# Director LLM chain (docs/DIRECTOR.md, "Failover"). All optional; keys stay server-side.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=8000
# GEMINI_TRANSIENT_RETRIES=1
# DIRECTOR_PRIMARY_PROVIDER=gemini
# DIRECTOR_SECONDARY_PROVIDER=anthropic
# DIRECTOR_BUDGET_MS=20000
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_TIMEOUT_MS=10000
# ANTHROPIC_EFFORT=low
TMDB_API_KEY=
WORLD_LABS_API_KEY=
ELEVENLABS_API_KEY=

# NPC voice (docs/VOICE.md). Needs ELEVENLABS_API_KEY and at least one voice.
# Unset: dialogue is text only.
# ELEVENLABS_VOICES=hank_schrader=<voice_id>,walter_white=<voice_id>
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TIMEOUT_MS=6000

TIDB_HOST=
TIDB_PORT=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=

# Tiger Data gameplay telemetry (docs/TELEMETRY.md). Backend only, with
# `--features tiger`. Unset: telemetry stays in memory.
# postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Phase 2 runtime (docs/RUNTIME.md). Unset: sessions run without a world.
# RIFT_WORLD_BIBLE=cache/universes/<universe_id>.json
# RIFT_SCENARIO=backend/tests/fixtures/runtime/scenario_burner_phone.json

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000

RUST_LOG=info
