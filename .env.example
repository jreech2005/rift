GEMINI_API_KEY=
TMDB_API_KEY=
WORLD_LABS_API_KEY=
ELEVENLABS_API_KEY=

# NPC voice (docs/VOICE.md). Needs ELEVENLABS_API_KEY and at least one voice.
# Unset: dialogue is text only.
# ELEVENLABS_VOICES=hank_schrader=<voice_id>,walter_white=<voice_id>
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TIMEOUT_MS=6000

TIDB_HOST=
TIDB_PORT=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=

# Phase 2 runtime (docs/RUNTIME.md). Unset: sessions run without a world.
# RIFT_WORLD_BIBLE=cache/universes/<universe_id>.json
# RIFT_SCENARIO=backend/tests/fixtures/runtime/scenario_burner_phone.json

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000

RUST_LOG=info
