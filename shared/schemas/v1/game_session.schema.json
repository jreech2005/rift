{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rift://schemas/v1/game_session",
  "title": "GameSession",
  "description": "Snapshot of authoritative session state (payload of session_created). Lives in Rust memory only. Source of truth: backend/src/session.rs.",
  "type": "object",
  "required": ["session_id", "created_at", "current_location", "world_flags", "recent_events", "event_count"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "current_location": { "type": ["string", "null"] },
    "world_flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "recent_events": { "type": "array", "maxItems": 32, "items": { "$ref": "rift://schemas/v1/world_event" } },
    "event_count": { "type": "integer", "minimum": 0 }
  }
}
