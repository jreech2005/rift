{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rift://schemas/v1/world_event",
  "title": "WorldEvent",
  "description": "Payload of a world_event message. Validated, structured outcome the game client executes. Source of truth: backend/src/action.rs.",
  "type": "object",
  "required": ["event_id", "session_id", "sequence", "event_type", "target", "payload", "timestamp"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid", "description": "UUIDv5 derived from action_id: deterministic." },
    "session_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1, "description": "Monotonic per session." },
    "event_type": {
      "enum": ["interaction_acknowledged", "inspection_acknowledged", "location_changed", "speech_acknowledged"]
    },
    "target": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
