                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "move_npc"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "npc_id",
              "location_id",
              "reason"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Change how an NPC feels about the player or another character.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "disposition": {
                "description": "The new disposition.",
                "enum": [
                  "hostile",
                  "wary",
                  "neutral",
                  "friendly",
                  "loyal"
                ],
                "type": "string"
              },
              "npc_id": {
                "description": "The NPC whose feelings change.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "reason": {
                "description": "Why, in one plain sentence.",
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "toward": {
                "description": "Whom the feeling is about: \"player\" or a character id.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "set_npc_disposition"
