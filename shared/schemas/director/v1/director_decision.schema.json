                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "event",
              "description"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "An NPC opens a conversation with the player.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
