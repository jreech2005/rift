{
  "$comment": "Generated from backend/src/director/schema.rs. Do not edit; run RIFT_UPDATE_SCHEMAS=1 cargo test.",
  "$id": "rift://schemas/director/v1/director_decision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A validated Director decision: zero or more typed, allowlisted actions. Not a wire message. Source of truth: backend/src/director/.",
  "properties": {
    "actions": {
      "description": "Typed actions in the order they should happen. May be empty.",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "description": "Give the player a new objective.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "description": {
                "description": "What the player should do and why.",
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "mission_id": {
                "description": "Active mission this objective belongs to. Omit for a stand-alone or replacement objective.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "objective_id": {
                "description": "A new lowercase snake_case id. Must not reuse an existing objective id.",
                "maxLength": 64,
                "pattern": "^[a-z0-9_]{1,64}$",
                "type": "string"
              },
              "title": {
                "description": "Short imperative shown to the player.",
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "set_objective"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "objective_id",
              "title",
              "description"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Mark an active objective as completed.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "objective_id": {
                "description": "An active objective.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "complete_objective"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "objective_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Mark an active objective as failed.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "objective_id": {
                "description": "An active objective.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "reason": {
                "description": "Why, in one plain sentence.",
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "fail_objective"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "objective_id",
              "reason"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Bring a known character who is not yet in play into the world at a location.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "location_id": {
                "description": "Where they appear.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "npc_id": {
                "description": "A known, living character who is not active.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "activate_npc"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "npc_id",
              "location_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Move an NPC to another location for a plausible in-world reason.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
