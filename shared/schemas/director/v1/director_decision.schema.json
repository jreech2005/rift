                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "source_npc_id": {
                "description": "The NPC it comes from, if any.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "text": {
                "description": "The information, as plain in-world prose.",
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "reveal_information"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "recipient_id",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Record a lasting fact about this playthrough.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "flag": {
                "description": "Flag key such as disclosed_to:some_npc. Must not start with \"interacted:\".",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "set_world_flag"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "flag"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Clear a flag that is currently set.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "flag": {
                "description": "A flag that is currently set.",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "clear_world_flag"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "flag"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Stage one of the allowed world events.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "description": {
                "description": "What happens, as plain in-world prose.",
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "event": {
                "description": "What kind of event to stage.",
                "enum": [
                  "alarm_raised",
                  "authorities_alerted",
                  "reinforcements_arrive",
                  "rumor_spreads",
                  "communication_received",
                  "confrontation_begins",
                  "environment_changes",
                  "tension_escalates"
                ],
                "type": "string"
              },
              "location_id": {
                "description": "Where it happens, if anywhere specific.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "npc_ids": {
                "description": "NPCs involved, without duplicates.",
                "items": {
                  "description": "An NPC involved.",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              "type": {
                "enum": [
                  "trigger_world_event"
