                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "npc_id": {
                "description": "The NPC who speaks.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "opening_line": {
                "description": "Their first line, in character.",
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "start_dialogue"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "npc_id",
              "opening_line"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Declare a mission impossible or meaningless because of what the player did.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "mission_id": {
                "description": "An active mission.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "reason": {
                "description": "Why, in one plain sentence.",
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "invalidate_mission"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "mission_id",
              "reason"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Ask the narrative engine to plan again.",
            "properties": {
              "action_id": {
                "description": "Unique within this decision, e.g. a1, a2.",
                "maxLength": 32,
                "pattern": "^[a-z0-9_]{1,32}$",
                "type": "string"
              },
              "mission_id": {
                "description": "Mission to replan; omit for the whole story.",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              "reason": {
                "description": "Why, in one plain sentence.",
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "request_replan"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "action_id",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 8,
      "type": "array"
    },
    "confidence": {
      "description": "How well this decision fits the canon and the player's action.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "decision_id": {
      "format": "uuid",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "description": "Assigned by the engine, never by a model.",
      "properties": {
        "attempts": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "based_on_event_count": {
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "fallback_reason": {
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "repaired": {
          "type": "boolean"
        },
        "usage": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "provider",
        "model",
        "attempts",
        "repaired",
        "latency_ms",
        "created_at",
        "based_on_event_count"
      ],
      "type": "object"
    },
    "narrative_summary": {
      "description": "One or two sentences: what the player did and how the world responds.",
      "maxLength": 400,
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "description": "Why this decision. no_change requires an empty actions list.",
      "enum": [
        "story_setup",
        "objective_progress",
        "player_divergence",
        "npc_reaction",
        "world_reaction",
        "no_change"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "trigger": {
      "additionalProperties": false,
      "description": "Why the Director was consulted. Copied from the DirectorContext.",
      "properties": {
        "kind": {
          "enum": [
            "session_start",
            "player_action",
            "objective_refused",
            "objective_completed",
            "objective_failed",
            "player_disclosure",
            "idle"
          ],
          "type": "string"
        },
        "npc_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "type": "string"
        },
        "objective_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "universe_id": {
      "pattern": "^[a-z0-9_]{1,128}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "session_id",
    "universe_id",
    "trigger",
    "reason_code",
    "actions",
    "confidence",
    "metadata"
  ],
  "title": "DirectorDecision",
  "type": "object"
}
