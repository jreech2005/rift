        "popularity": {
          "default": 0.0,
          "title": "Popularity",
          "type": "number"
        },
        "vote_count": {
          "default": 0,
          "title": "Vote Count",
          "type": "integer"
        }
      },
      "required": [
        "tmdb_id",
        "media_type",
        "title"
      ],
      "title": "TitleCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "universe": {
      "$ref": "#/$defs/ResolvedUniverse"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/CanonDocument"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CanonFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/PacketProvenance"
    }
  },
  "required": [
    "universe",
    "documents",
    "retrieved_at",
    "provenance"
  ],
  "title": "CanonPacket",
  "type": "object"
}
